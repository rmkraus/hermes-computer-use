# Hermes Computer Use — environment file
# Copy to /etc/hermes-computer-use.env and fill in your values.
#
# Install the systemd services:
#
#   sudo cp scripts/hermes-computer-use-openai.service /etc/systemd/system/
#   sudo cp scripts/hermes-computer-use-mcp.service    /etc/systemd/system/
#   sudo cp scripts/hermes-computer-use.env.example   /etc/hermes-computer-use.env
#   sudo systemctl daemon-reload
#
# Enable and start (pick one or both):
#
#   sudo systemctl enable --now hermes-computer-use-openai
#   sudo systemctl enable --now hermes-computer-use-mcp
#
# View logs:
#
#   journalctl -u hermes-computer-use-openai -f
#   journalctl -u hermes-computer-use-mcp -f

# ── Required ──────────────────────────────────────────────────────────────────

# NVIDIA NIM API key (https://build.nvidia.com → Get API Key)
NVIDIA_API_KEY=nvapi-REPLACE_ME

# ── Model selection ───────────────────────────────────────────────────────────

# Vision-capable model for desktop automation.
# Must support both tool-calling AND image inputs.
# Good choices:
#   meta/llama-3.2-11b-vision-instruct   (fast, default)
#   meta/llama-3.2-90b-vision-instruct   (more capable)
COMPUTER_USE_MODEL=meta/llama-3.2-11b-vision-instruct

# Optional: override the NIM base URL (leave blank to use api.nvidia.com)
# Set this if pointing at a local vLLM instance or custom NIM endpoint.
# Example: http://localhost:8000/v1
NIM_BASE_URL=

# ── Ports ─────────────────────────────────────────────────────────────────────

# Host port for the OpenAI-compatible API (maps to container port 8000)
OPENAI_HOST_PORT=8000

# Host port for the MCP endpoint (maps to container port 9901)
MCP_HOST_PORT=9901

# ── Image ─────────────────────────────────────────────────────────────────────

# Docker image to run. Pin to a specific tag in production.
COMPUTER_USE_IMAGE=ghcr.io/rmkraus/hermes-computer-use:latest
