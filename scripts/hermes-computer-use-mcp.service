[Unit]
Description=Hermes Computer Use — MCP Mode
Documentation=https://github.com/rmkraus/hermes-computer-use
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/etc/hermes-computer-use.env

# Pull latest image before starting (optional — remove if using pinned tags)
ExecStartPre=-/usr/bin/docker pull ${COMPUTER_USE_IMAGE:-ghcr.io/rmkraus/hermes-computer-use:latest}
# Remove any leftover container from a previous run
ExecStartPre=-/usr/bin/docker rm -f hermes-computer-use-mcp

ExecStart=/usr/bin/docker run \
    --name hermes-computer-use-mcp \
    --rm \
    --init \
    -p ${MCP_HOST_PORT:-9901}:9901 \
    -e NVIDIA_API_KEY=${NVIDIA_API_KEY} \
    -e COMPUTER_USE_MODEL=${COMPUTER_USE_MODEL:-meta/llama-3.2-11b-vision-instruct} \
    -e NIM_BASE_URL=${NIM_BASE_URL:-} \
    ${COMPUTER_USE_IMAGE:-ghcr.io/rmkraus/hermes-computer-use:latest} mcp

ExecStop=/usr/bin/docker stop hermes-computer-use-mcp

Restart=on-failure
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

# Log to journald (view with: journalctl -u hermes-computer-use-mcp -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-computer-use-mcp

[Install]
WantedBy=multi-user.target
